root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml,json,html,js,css}]
indent_size = 2

[*.cs]
# Jellyfin convention: message-template logging is used throughout the server; LoggerMessage
# source generation adds noise without measurable benefit for this plugin's log volume.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# Plugin public types are consumed by Jellyfin's DI and MVC, not by third-party callers.
dotnet_diagnostic.CA1515.severity = none
dotnet_diagnostic.CA1716.severity = none
csharp_style_namespace_declarations = file_scoped:suggestion
